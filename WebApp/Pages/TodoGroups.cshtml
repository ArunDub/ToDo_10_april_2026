@page
@model TodoGroupsModel
@{
    ViewData["Title"] = "TodoGroups";
}
<section class="content pt-3 pb3">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <!-- TO DO List -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ion ion-clipboard mr-1"></i>
                            Todo Groups
                        </h3>
                        <div class="card-tools w-50">
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-navbar" placeholder="Enter Name">
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-primary" onclick="Add(this)">
                                        <i class="fas fa-plus"></i> Add new item
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        @if(Model.modelVm.Count>=0)
                        {
                            <ul class="todo-list" data-widget="todo-list">
                                @foreach (var item in Model.modelVm)
                                {
                                    <li>
                                        <!-- todo text -->
                                        <span id="@($"spanName-{item.Id}")" class="text">@item.GroupName</span>
                                        <input id="@($"txtName-{item.Id}")" type="text"  class="form-control form-control-navbar w-50 d-none" value="@item.GroupName" />

                                        <!-- General tools such as edit or delete-->
                                        <div class="tools">
                                            <button id="@($"btnEdit-{item.Id}")" type="button" class="btn btn-warning btn-sm" onclick="Edit('@item.Id')"><i class="fas fa-edit"></i></button>
                                            <button id="@($"btnDelete-{item.Id}")" type="button" class="btn btn-danger btn-sm" onclick="Delete('@item.Id')"><i class="fas fa-trash"></i></button>
                                            <button id="@($"btnSave-{item.Id}")" type="button" class="btn btn-success btn-sm d-none" onclick="Save('@item.Id')"><i class="fas fa-save"></i></button>
                                            <button id="@($"btnCancel-{item.Id}")" type="button" class="btn btn-secondary btn-sm d-none" onclick="Cancel('@item.Id')"><i class="fas fa-times"></i></button>
                                        </div>
                                    </li>
                                }

                            </ul>
                        }
                        else
                        {
                            <p>Record Not found</p>
                        }

                        
                    </div>
                    <!-- /.card-body -->
                    <div class="card-footer clearfix">
                    </div>
                </div>
                <!-- /.card -->

            </div>
        </div>
    </div>
</section>

//https://www.youtube.com/watch?v=xBIOlQMQot4&list=PLQr7op4-p7tMl_c0gryHrGIrNkBtGkLsY&index=19
@section Scripts{
    <script type="text/javascript">
    function Add(ctrl){
        var txtName=$(ctrl).parent().prev('input[type=text]');
        var name=$(txtName).val();
        if(name!='')
        {
            var btnHtml=$(ctrl).html();
            $(ctrl).attr('disabled',true);
            $(ctrl).html('<i class="fa fa-spinner fa-spin"></i> wait');
            $.get('?Handler=Add',{name:name})
            .done(function(data){
                $(txtName).val();
                $(ctrl).attr('disabled',false);
                $(ctrl).html(btnHtml);
                toastr.info(data,'',{
                onHidden:function(){
                window.location.reload();                
                }
                
            })
         });
        }
        else
        {
            toastr.error('Pls enter Name');
        }
    }  
    function Edit(id){
        //hide name
            $('#spanName-' + id).removeClass('d-inline').addClass('d-none');
        //Hide Edit button
        $('#btnEdit-' + id).removeClass('d-inline').addClass('d-none');
        //hide Delete Button
        $('#btnEdit-' + id).removeClass('d-inline').addClass('d-none');

        //Show input text
        $('#txtName-' + id).removeClass('d-none').addClass('d-inline');
        //show Save button
        $('#btnSave-' + id).removeClass('d-none').addClass('d-inline');
        //show Cancel button
        $('#btnCancel-' + id).removeClass('d-none').addClass('d-inline');
    }

     function Cancel(id){
        //show name
        $('#spanName-'+id).removeClass('d-none').addClass('d-inline');
        //showEdit Button'
            $('#btnEdit-' + id).removeClass('d-none').addClass('d-inline');
            //show Delete Button'
            $('#btnDelete-' + id).removeClass('d-none').addClass('d-inline');
            //Hide input text
        $('#txtName-' + id).removeClass('d-inline').addClass('d-none');
            //hide save button
            $('#btnSave-' + id).removeClass('d-inline').addClass('d-none');
            //hide Cancel button
        $('#btnCancel-' + id).removeClass('d-inline').addClass('d-none');
    }
    
    </script>
}
